port\n in screen coordinates (-1.0 to 1.0). Read more… Arguments Type Intent Optional Attributes Name real(kind=real32), intent(out) :: left real(kind=real32), intent(out) :: right real(kind=real32), intent(out) :: bottom real(kind=real32), intent(out) :: top public  subroutine draw_popviewport () Read more… Arguments None public  subroutine draw_pushviewport () Read more… Arguments None public  subroutine draw_viewport (xlow, xhigh, ylow, yhigh) Sample program: Read more… Arguments Type Intent Optional Attributes Name real(kind=real32), intent(in) :: xlow real(kind=real32), intent(in) :: xhigh real(kind=real32), intent(in) :: ylow real(kind=real32), intent(in) :: yhigh","tags":"","url":"module/m_draw_viewp.html"},{"title":"m_draw_drv_mif – M_drawtran","text":"Uses m_draw_pref m_draw_types m_draw_drivers iso_fortran_env Functions public  function MIF4_draw_devcpy () Arguments None Return Value integer public  function MIF_draw_devcpy () Arguments None Return Value integer","tags":"","url":"module/m_draw_drv_mif.html"},{"title":"m_draw_drv_ppm – M_drawtran","text":"Uses m_draw_bitmap_fonts m_draw_types m_draw_drivers iso_fortran_env m_draw_pref Functions public  function CHAR_draw_devcpy () Arguments None Return Value integer public  function P3_draw_devcpy () Arguments None Return Value integer public  function P6_draw_devcpy () Arguments None Return Value integer public  function PPM_draw_devcpy () Arguments None Return Value integer","tags":"","url":"module/m_draw_drv_ppm.html"},{"title":"m_draw_verror – M_drawtran","text":"Uses m_draw_types iso_fortran_env Subroutines public  subroutine draw_verror (str) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: str","tags":"","url":"module/m_draw_verror.html"},{"title":"m_draw_attr – M_drawtran","text":"Uses m_draw_verror m_draw_aspect m_draw_buffer iso_fortran_env m_draw_types Subroutines public  subroutine draw_getattribs (s) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: s public  subroutine draw_popattributes () Read more… Arguments None public  subroutine draw_printattribs (s) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: s public  subroutine draw_printlogicals (s) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: s public  subroutine draw_printvdevice (s) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: s public  subroutine draw_pushattributes () Read more… Arguments None","tags":"","url":"module/m_draw_attr.html"},{"title":"m_draw_mapping.f90 – M_drawtran","text":"Source Code module m_draw_mapping use , intrinsic :: iso_fortran_env , only : real32 use m_draw_types implicit none private public :: draw_VtoWxy , draw_CalcW2Vcoeffs , draw_WtoVx , draw_WtoVy real ( real32 ), save :: Vcx = 0.0_real32 , Vcy = 0.0_real32 real ( real32 ), save :: Vsx = 1.0_real32 , Vsy = 1.0_real32 contains subroutine draw_VtoWxy ( xs , ys , xw , yw ) real ( real32 ), intent ( in ) :: xs , ys real ( real32 ), intent ( out ) :: xw , yw real ( real32 ) :: d , a1 , a2 , b1 , b2 , c1 , c2 , A , B A = ( xs - Vcx ) / Vsx B = ( ys - Vcy ) / Vsy a1 = vdevice % transmat % m ( 1 , 1 ) - vdevice % transmat % m ( 1 , 4 ) * A a2 = vdevice % transmat % m ( 1 , 2 ) - vdevice % transmat % m ( 1 , 4 ) * B b1 = vdevice % transmat % m ( 2 , 1 ) - vdevice % transmat % m ( 2 , 4 ) * A b2 = vdevice % transmat % m ( 2 , 2 ) - vdevice % transmat % m ( 2 , 4 ) * B c1 = vdevice % transmat % m ( 4 , 4 ) * A - vdevice % transmat % m ( 4 , 1 ) c2 = vdevice % transmat % m ( 4 , 4 ) * B - vdevice % transmat % m ( 4 , 2 ) d = ( a2 * b1 - b2 * a1 ) if ( d /= 0.0_real32 ) then xw = ( b1 * c2 - c1 * b2 ) / d yw = ( c1 * a2 - a1 * c2 ) / d else xw = A yw = B end if if ( xw == 0.0_real32 ) xw = A if ( yw == 0.0_real32 ) yw = B end subroutine draw_VtoWxy subroutine draw_CalcW2Vcoeffs () Vcx = real ( vdevice % maxVx + vdevice % minVx , real32 ) * 0.5_real32 Vcy = real ( vdevice % maxVy + vdevice % minVy , real32 ) * 0.5_real32 Vsx = real ( vdevice % maxVx - vdevice % minVx , real32 ) * 0.5_real32 Vsy = real ( vdevice % maxVy - vdevice % minVy , real32 ) * 0.5_real32 end subroutine draw_CalcW2Vcoeffs integer function draw_WtoVx ( p ) real ( real32 ), intent ( in ) :: p ( 4 ) draw_WtoVx = int ( p ( 1 ) * Vsx / p ( 4 ) + Vcx + 0.5_real32 ) end function draw_WtoVx integer function draw_WtoVy ( p ) real ( real32 ), intent ( in ) :: p ( 4 ) draw_WtoVy = int ( p ( 2 ) * Vsy / p ( 4 ) + Vcy + 0.5_real32 ) end function draw_WtoVy end module m_draw_mapping","tags":"","url":"sourcefile/m_draw_mapping.f90.html"},{"title":"m_draw_drv_fti.f90 – M_drawtran","text":"Source Code module m_draw_drv_fti use , intrinsic :: iso_fortran_env , only : real32 , output_unit , error_unit use m_draw_types use m_draw_drivers implicit none private public :: FTI_draw_devcpy integer , save :: GLOBAL_color = 0 integer , save :: GLOBAL_lastx = - 1111111 integer , save :: GLOBAL_lasty = - 1111111 contains integer function FTI_color ( col ) integer , intent ( in ) :: col integer :: icol GLOBAL_color = abs ( mod ( col , 256 )) if ( GLOBAL_color > 15 ) then icol = - GLOBAL_color else icol = GLOBAL_color end if select case ( icol ) case ( 0 ) write ( draw_unit , '(A)' ) \"color(iconcolor);\" case ( 7 ) write ( draw_unit , '(A)' ) \"color(outlinecolor);\" case default write ( draw_unit , '(A, I0, A)' ) \"color(\" , icol , \");\" end select FTI_color = 0 end function FTI_color integer function FTI_init () vdevice % sizeSy = 1000 vdevice % sizeSx = 1000 vdevice % sizeX = 1000 vdevice % sizeY = 1000 vdevice % depth = 1 draw_unit = draw_outfile () GLOBAL_lastx = - 1111111 GLOBAL_lasty = - 1111111 write ( draw_unit , '(A)' ) \"#FTI\" write ( draw_unit , '(A)' ) \"# CREATOR: M_DRAW FTI driver; version 1.0 1997/08/02\" write ( draw_unit , '(A)' ) \"# Version 1: 19970802, Author: John S. Urban\" write ( draw_unit , '(A)' ) \"color(outlinecolor);\" FTI_init = 1 end function FTI_init integer function FTI_fill ( n , x , y ) integer , intent ( in ) :: n integer , intent ( in ) :: x ( n ), y ( n ) integer :: i write ( draw_unit , '(A)' ) \"bgnpolygon();\" do i = 1 , n write ( draw_unit , '(A, F0.4, A, F0.4, A)' ) \"   vertex(\" , x ( i ) / 1 0.0_real32 , \",\" , y ( i ) / 1 0.0_real32 , \");\" end do write ( draw_unit , '(A)' ) \"endpolygon();\" GLOBAL_lastx = x ( n ); vdevice % cpVx = x ( n ) GLOBAL_lasty = y ( n ); vdevice % cpVy = y ( n ) FTI_fill = UNUSED end function FTI_fill integer function FTI_draw ( x , y ) integer , intent ( in ) :: x , y if ( GLOBAL_lastx /= vdevice % cpVx . or . GLOBAL_lasty /= vdevice % cpVy ) then GLOBAL_lastx = vdevice % cpVx GLOBAL_lasty = vdevice % cpVy write ( draw_unit , '(A, F0.4, A, F0.4, A)' ) \"move(\" , GLOBAL_lastx / 1 0.0_real32 , \",\" , GLOBAL_lasty / 1 0.0_real32 , \");\" end if write ( draw_unit , '(A, F0.4, A, F0.4, A)' ) \"draw(\" , x / 1 0.0_real32 , \",\" , y / 1 0.0_real32 , \");\" FTI_draw = UNUSED end function FTI_draw integer function FTI_exit () flush ( draw_unit ) if ( draw_unit /= output_unit . and . draw_unit /= error_unit ) then write ( draw_unit , '(A)' ) \"# End of FTI File\" flush ( draw_unit ) close ( draw_unit ) end if FTI_exit = UNUSED end function FTI_exit integer function FTI_clear () write ( draw_unit , '(A)' ) \"# End of FTI Page\" FTI_clear = UNUSED end function FTI_clear integer function FTI_font ( font ) character ( len =* ), intent ( in ) :: font write ( error_unit , '(A)' ) \"error: NO HARDWARE FONT\" if ( trim ( font ) == \"small\" ) then vdevice % hwidth = 9 7.01_real32 vdevice % hheight = vdevice % hwidth * 2.0_real32 else if ( trim ( font ) == \"large\" ) then vdevice % hwidth = 14 5.5_real32 vdevice % hheight = vdevice % hwidth * 2.0_real32 else FTI_font = 0 ; return end if FTI_font = 1 end function FTI_font integer function FTI_string ( s ) character ( len =* ), intent ( in ) :: s if ( GLOBAL_lastx /= vdevice % cpVx . or . GLOBAL_lasty /= vdevice % cpVy ) then GLOBAL_lastx = vdevice 