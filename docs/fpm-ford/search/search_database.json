 xterm -ti vt340, foot, WezTerm, Konsole)\tPixel-accurate vector/raster output identical to X11/Win32 when Sixel is supported ! ! 2. How Unicode Braille Sub-Pixel Mapping Works ! ! Each Unicode Braille character (U+2800 + bitmask) encodes a 2×4 grid ! of sub-pixels inside a single terminal cell: ! text ! ! Sub-pixel offsets inside one character cell: !   (0,0) = bit 0 (0x01)   (1,0) = bit 3 (0x08) !   (0,1) = bit 1 (0x02)   (1,1) = bit 4 (0x10) !   (0,2) = bit 2 (0x04)   (1,2) = bit 5 (0x20) !   (0,3) = bit 6 (0x40)   (1,3) = bit 7 (0x80) ! !     Maintaining an internal framebuffer fb(0:width-1, 0:height-1) !     of packed RGB colors (0 = background) lets Vdraw (Bresenham line !     algorithm), Vfill (scanline polygon fill), and Vstring draw at 2×4 !     sub-pixel resolution. ! !     On Vsync / Vswapb / Vgetkey, the driver flushes the framebuffer to !     stdout using ANSI cursor positioning (ESC[H), 24-bit foreground colors !     (ESC[38;2;R;G;Bm), and UTF-8 encoded Braille characters (char(226) !     // char(160 + mask/64) // char(128 + mod(mask,64))). ! !     Even mouse input works via ANSI SGR mouse reporting (ESC[?1000;1006h), !     which sends ESC[<button;col;rowM over stdin when clicked! ! module m_draw_drv_ansi use , intrinsic :: iso_fortran_env , only : real32 , output_unit , input_unit use m_draw_types use m_draw_pref use m_draw_verror implicit none private public :: ansi_draw_devcpy , ansi_low_draw_devcpy integer , parameter :: CMAPSIZE = 256 integer , parameter :: DEV_ANSI_UPPER = 0 ! Black background (\"ANSI\") integer , parameter :: DEV_ANSI_LOWER = 1 ! White background (\"ansi\") character ( len = 1 ), parameter :: ESC = char ( 27 ) ! Braille dot bit weights for (dx=0..1, dy=0..3) integer , parameter :: BRAILLE_BIT ( 0 : 1 , 0 : 3 ) = reshape ([ & 1 , 8 , & ! dy = 0: (0,0)=0x01, (1,0)=0x08 2 , 16 , & ! dy = 1: (0,1)=0x02, (1,1)=0x10 4 , 32 , & ! dy = 2: (0,2)=0x04, (1,2)=0x20 64 , 128 & ! dy = 3: (0,3)=0x40, (1,3)=0x80 ], [ 2 , 4 ]) ! Driver state integer , allocatable , save :: fb (:, :) ! Packed RGB (0 = unset/bg), indexed (0:W-1, 0:H-1) integer , save :: cmap ( 3 , 0 : CMAPSIZE - 1 ) = 0 ! RGB palette (0..255) integer , save :: cur_color_idx = 7 integer , save :: bg_color_idx = 0 integer , save :: cur_lw = 1 integer , save :: cols = 80 , rows = 24 integer , save :: pix_w = 160 , pix_h = 96 integer , save :: back_used = 0 integer , save :: GLOBAL_device = DEV_ANSI_UPPER logical , save :: dirty = . false . contains pure integer function pack_rgb ( r , g , b ) integer , intent ( in ) :: r , g , b ! Bit 24 marks pixel as drawn so black (0,0,0) on white bg is distinguishable pack_rgb = ior ( ishft ( 1 , 24 ), ior ( ior ( iand ( r , 255 ), ishft ( iand ( g , 255 ), 8 )), ishft ( iand ( b , 255 ), 16 ))) end function pack_rgb subroutine set_pixel ( x , y , packed ) integer , intent ( in ) :: x , y , packed integer :: dx , dy , r if ( cur_lw <= 1 ) then if ( x >= 0 . and . x < pix_w . and . y >= 0 . and . y < pix_h ) then fb ( x , y ) = packed end if else r = cur_lw / 2 do dy = - r , r do dx = - r , r if ( x + dx >= 0 . and . x + dx < pix_w . and . y + dy >= 0 . and . y + dy < pix_h ) then fb ( x + dx , y + dy ) = packed end if end do end do end if end subroutine set_pixel subroutine draw_bresenham ( x0_in , y0_in , x1_in , y1_in , packed ) integer , intent ( in ) :: x0_in , y0_in , x1_in , y1_in , packed integer :: x0 , y0 , x1 , y1 , dx , dy , sx , sy , err , e2 x0 = x0_in ; y0 = y0_in x1 = x1_in ; y1 = y1_in dx = abs ( x1 - x0 ) dy = - abs ( y1 - y0 ) sx = merge ( 1 , - 1 , x0 < x1 ) sy = merge ( 1 , - 1 , y0 < y1 ) err = dx + dy do call set_pixel ( x0 , y0 , packed ) if ( x0 == x1 . and . y0 == y1 ) exit e2 = 2 * err if ( e2 >= dy ) then err = err + dy x0 = x0 + sx end if if ( e2 <= dx ) then err = err + dx y0 = y0 + sy end if end do end subroutine draw_bresenham subroutine render_frame () integer :: cx , cy , dx , dy , px , py , mask , cell_rgb , p integer :: r , g , b , last_rgb character ( len = 3 ) :: utf8_braille character ( len = 32 ) :: esc_buf ! Hide cursor, move home, set background color r = cmap ( 1 , bg_color_idx ); g = cmap ( 2 , bg_color_idx ); b = cmap ( 3 , bg_color_idx ) write ( output_unit , '(A,I0,A,I0,A,I0,A)' , advance = 'no' ) & ESC // '[?25l' // ESC // '[H' // ESC // '[48;2;' , r , ';' , g , ';' , b , 'm' last_rgb = - 1 do cy = 0 , rows - 1 do cx = 0 , cols - 1 mask = 0 cell_rgb = 0 do dy = 0 , 3 py = cy * 4 + dy do dx = 0 , 1 px = cx * 2 + dx p = fb ( px , py ) if ( p /= 0 ) then mask = ior ( mask , BRAILLE_BIT ( dx , dy )) cell_rgb = iand ( p , int ( Z 'FFFFFF' )) end if end do end do if ( mask == 0 ) then write ( output_unit , '(A)' , advance = 'no' ) ' ' else if ( cell_rgb /= last_rgb ) then r = iand ( cell_rgb , 255 ) g = iand ( ishft ( cell_rgb , - 8 ), 255 ) b = iand ( ishft ( cell_rgb , - 16 ), 255 ) write ( esc_buf , '(A,I0,A,I0,A,I0,A)' ) ESC // '[38;2;' , r , ';' , g , ';' , b , 'm' write ( output_unit , '(A)' , advance = 'no' ) trim ( esc_buf ) last_rgb = cell_rgb end if ! UTF-8 encoding for U+2800 + mask (0xE2 0xA0..0xA3 0x80..0xBF) utf8_braille ( 1 : 1 ) = char ( 226 ) utf8_braille ( 2 : 2 ) = char ( 160 + ishft ( mask , - 6 )) utf8_braille ( 3 : 3 ) = char ( 128 + iand ( mask , 63 )) write ( output_unit , '(A)' , advance = 'no' ) utf8_braille end if end do if ( cy < rows - 1 ) write ( output_unit , '(A)' ) '' end do ! Reset attributes and show cursor write ( output_unit , '(A)' , advance = 'no' ) ESC // '[0m' // ESC // '[?25h' flush ( output_unit ) dirty = . false . end subroutine render_frame integer function ANSI_init () integer :: prefx , prefy , prefxs , prefys , idum call draw_getprefposandsize ( prefx , prefy , prefxs , prefys ) ! Allow prefsize in pixels (divided by 2x4) or default 80x24 cells (160x96 subpixels) if ( prefxs > 0 . and . prefys > 0 ) then cols = max ( 10 , prefxs / 2 ) rows = max ( 5 , prefys / 4 ) else cols = 80 rows = 24 end if pix_w = cols * 2 pix_h = rows * 4 if ( allocated ( fb )) deallocate ( fb ) allocate ( 