ST_Y = int(real(vdevice%cpVy, real32) + slength * vdevice%attr%a%textsin) PDF_string = 0 end function PDF_string integer function PDF_char(c) character(len=1), intent(in) :: c integer :: idum idum = PDF_string(c) PDF_char = 0 end function PDF_char integer function PDF_fill(n, x, y) integer, intent(in) :: n integer, intent(in) :: x(n), y(n) integer :: i call closeline() call closeObject() write(draw_unit, ' ( I0 , 1 X , I0 , A ) ') x(1), y(1), \" m\" do i = 2, n if (mod(i - 1, 8) == 7) then write(draw_unit, ' ( I0 , 1 X , I0 , A ) ') x(i), y(i), \" l\" else write(draw_unit, ' ( I0 , 1 X , I0 , A ) ', advance=' no ') x(i), y(i), \" l \" end if end do write(draw_unit, ' ( I0 , 1 X , I0 , A , / , A ) ' ) x ( 1 ), y ( 1 ), \" l\" , \"f*\" vdevice % cpVx = x ( n ); vdevice % cpVy = y ( n ) LAST_X = vdevice % cpVx ; LAST_Y = vdevice % cpVy drawn = 1 PDF_fill = 0 end function PDF_fill integer function noop (); noop = - 1 ; end function integer function noop2 ( x , y ); integer , intent ( out ) :: x , y ; x = 0 ; y = 0 ; noop2 = - 1 ; end function integer function PDF_draw_devcpy () vdevice % dev % devname = \"pdf\" vdevice % dev % large = \"large\" vdevice % dev % small = \"small\" vdevice % dev % Vbackb => noop vdevice % dev % Vchar => PDF_char vdevice % dev % Vcheckkey => noop vdevice % dev % Vclear => PDF_clear vdevice % dev % Vcolor => PDF_color vdevice % dev % Vdraw => PDF_draw vdevice % dev % Vexit => PDF_exit vdevice % dev % Vfill => PDF_fill vdevice % dev % Vfont => PDF_font vdevice % dev % Vfrontb => noop vdevice % dev % Vgetkey => noop vdevice % dev % Vinit => PDF_init vdevice % dev % Vlocator => noop2 vdevice % dev % Vmapcolor => PDF_mapcolor vdevice % dev % Vsetlw => PDF_setlw vdevice % dev % Vstring => PDF_string vdevice % dev % Vswapb => noop vdevice % dev % Vsync => noop PDF_draw_devcpy = 0 end function PDF_draw_devcpy end module m_draw_drv_pdf","tags":"","url":"sourcefile/m_draw_drv_pdf.f90.html"},{"title":"m_draw_pref.f90 – M_drawtran","text":"Source Code module m_draw_pref use , intrinsic :: iso_fortran_env , only : error_unit implicit none private public :: draw_prefposition , draw_prefsize , draw_getprefposandsize integer , save :: px = - 1 , py = - 1 , pxs = - 1 , pys = - 1 contains !> !!##NAME !!    prefposition(3f) - [M_draw:WINDOW_SETUP] Specify preferred position of window !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!    subroutine prefposition(x, y) !! !!     integer,intent(in) :: x, y !! !!##DESCRIPTION !!    Specify the preferred position of the window opened by the *next* !!    vinit in raster units or units of resolution, depending on the output !!    device. The physical size of the units are generally device-specific -- !!    For X11 Windows and PPM pixmaps the values would represent rasters. !!    For vector output devices the number of \"rasters\" per inch varies. !! !!##EXAMPLE !! !!   Sample program: !! !!      program demo_prefposition !!      use M_draw, only    : prefsize, vinit, ortho2, clear, getkey !!      use M_draw, only    : prefposition, move2, draw2, vexit, color !!      use M_draw,    only  : D_BLACK,   D_WHITE !!      use M_draw,    only  : D_RED,     D_GREEN,    D_BLUE !!      use M_draw,    only  : D_YELLOW,  D_MAGENTA,  D_CYAN !!      implicit none !!      integer :: ipaws !! !!      call prefsize(60,40) !!      call prefposition(100,100) !! !!      call vinit(' ')         ! start graphics using device $M_DRAW_DEVICE !!      call ortho2(-300.0,300.0,-200.0,200.0) !!      call color(D_BLACK) !!      call clear() !!      call color(D_RED) !!      call move2(-300.0,-200.0) !!      call draw2(300.0,200.0) !!      call move2(300.0,-200.0) !!      call draw2(-300.0,200.0) !!      ipaws=getkey() !!      call vexit() !! !!      end program demo_prefposition subroutine draw_prefposition ( x , y ) integer , intent ( in ) :: x , y if ( x < - 1 ) then write ( error_unit , '(A, I0)' ) 'prefposition: bad x value ' , x px = - 1 py = - 1 end if if ( y < - 1 ) then write ( error_unit , '(A, I0)' ) 'prefposition: bad y value ' , y px = - 1 py = - 1 end if px = x py = y end subroutine draw_prefposition !> !!##NAME !!    prefsize(3f) - [M_draw:WINDOW_SETUP] Specify preferred width and !!    height of window in physical units !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!         subroutine prefsize(width, height) !!         integer,intent(in) :: width, height !! !!##DESCRIPTION !! !!    Specify the preferred width and height of the device output surface !!    opened by the *next* vinit(3f). !! !!##OPTIONS !!    WIDTH   width of device to create when vinit(3f) is called !!    HEIGHT  height of device to create when vinit(3f) is called !! !!##EXAMPLE !! !!   Sample program: !! !!      program demo_prefsize !!      use M_draw, only: prefsize, vinit, ortho2, clear, getkey !!      use M_draw, only: move2, draw2, vexit, color !!      use M_draw,    only  : D_BLACK,   D_WHITE !!      use M_draw,    only  : D_RED,     D_GREEN,    D_BLUE !!      use M_draw,    only  : D_YELLOW,  D_MAGENTA,  D_CYAN !!      implicit none !!      integer :: ipaws !!         ! make first file with one size !!         call prefsize(60*2,40*2) !!         call vinit(' ') ! start graphics using device $M_DRAW_DEVICE !!         call picture() !!         ipaws=getkey() !!         call vexit() !! !!         ! make second file with another size !!         call prefsize(60*3,40*3) !!         call vinit(' ') !!         call picture() !!         ipaws=getkey() !!         call vexit() !!      contains !!      subroutine picture !!         call ortho2(-300.0,300.0,-200.0,200.0) !!         call color(D_BLACK) !!         call clear() !!         call color(D_RED) !!         call move2(-300.0,-200.0) !!         call draw2(300.0,200.0) !!         call move2(300.0,-200.0) !!         call draw2(-300.0,200.0) !!      end subroutine picture !!      end program demo_prefsize subroutine draw_prefsize ( x , y ) integer , intent ( in ) :: x , y if ( x < - 1 . or . x == 0 ) then write ( error_unit , '(A, I0)' ) 'prefsize: bad x value ' , x px = - 1 py = - 1 end if if ( y < - 1 . or . y == 0 ) then write ( error_unit , '(A, I0)' ) 'prefsize: bad y value ' , y px = - 1 py = - 1 end if pxs = x pys = y end subroutine draw_prefsize subroutine draw_getprefposandsize ( x , y , xs , ys ) integer , intent ( out ) :: x , y , xs , ys x = px y = py xs = pxs ys = pys end subroutine draw_getprefposandsize end module m_draw_pref","tags":"","url":"sourcefile/m_draw_pref.f90.html"},{"title":"m_draw_objects.f90 – M_drawtran","text":"Source Code module m_draw_objects use , intrinsic :: iso_fortran_env , only : real32 , error_unit use m_draw_types use m_draw_verror use m_draw_newtokens use m_draw_matrix use m_draw_tensor use m_draw_move use m_draw_draw use m_draw_arcs use m_draw_curves use m_draw_patches use m_draw_polygons use m_draw_rect use m_draw_text use m_draw_attr use m_draw_viewp use m_draw_buffer use m_draw_trans implicit none private public :: draw_makeobj , draw_closeobj , draw_delobj , draw_genobj , & draw_getopenobj , draw_loadobj , draw_saveobj , draw_callobj , draw_isobj type :: Object integer :: obno = 0 type ( TokList ), pointer :: tlist => null () type ( Object ), pointer :: next => null () end type Object type :: ObjectPtr type ( Object ), pointer :: ptr => null () end type ObjectPtr type ( ObjectPtr ), save :: object_table ( MAXENTS ) integer , save :: obno = - 1 , omax = 0 interface subroutine draw_color ( i ) integer , intent ( in ) :: i end subroutine draw_color subroutine draw_linewidth ( w ) integer , intent ( in ) :: w end subroutine draw_linewidth subroutine draw_mapcolor ( i , r , g , b ) use , intrinsic :: iso_fortran_env , only : int16 integer , intent ( in ) :: i integer ( int16 ), intent ( in ) :: r , g , b end subroutine draw_mapcolor end interface contains pure integer function obj_hash ( n ) integer , intent ( in ) :: n obj_hash = mod ( abs ( n ), MAXENTS ) + 1 end function obj_hash !> !!##NAME !!    makeobj(3f) - [M_draw:OBJECT] Commence the object number n. !!    (LICENSE:PD) !!##SYNOPSIS !! !!         subroutine makeobj(n) !!         integer n !! !!##DESCRIPTION !!    Commence the object number n. subroutine draw_makeobj ( n ) integer , intent ( in ) :: n type ( Object ), pointer :: o integer :: idx if ( vdevice % initialized == 0 ) call draw_verror ( \"makeobj: draw not initialized\" ) idx = obj_hash ( n ) o => object_table ( idx )% ptr do while ( associated ( o )) if ( o % obno == n ) then call draw_delobj ( n ) exit end if o => o % next end do obno = n vdevice % tokens => null () vdevice % inobject = 1 if ( omax <= n ) omax = n + 1 end subroutine draw_makeobj !> !!##NAME !!    closeobj(3f) - [M_draw:OBJECT] Close the current object. !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!         subroutine closeobj() !!##DESCRIPTION !! !!    Close the current object. subroutine draw_closeobj () type ( Object ), pointer :: o integer :: idx if ( vdevice % inobject == 0 ) call draw_verror ( \"closeobj: not in an object\" ) vdevice % inobject = 0 idx = obj_hash ( obno ) allocate ( o ) o % obno = obno o % tlist => vdevice % tokens o % next => object_table ( idx )% ptr object_table ( idx )% ptr => o obno = - 1 end subroutine draw_closeobj !> !!##NAME !!    delobj(3f) - [M_draw:OBJECT] Delete the object number n. !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!         subroutine delobj(n) !!         integer n !!##DESCRIPTION !!    Delete the object number n. subroutine draw_delobj ( n ) integer , intent ( in ) :: n type ( Object ), pointer :: o , lo type ( TokList ), pointer :: tl , ntl integer :: idx idx = obj_hash ( n ) lo => null () o => object_table ( idx )% ptr do while ( associated ( o )) if ( o % obno == n ) exit lo => o o => o % next end do if ( associated ( o )) then tl => o % tlist do while ( associated ( tl )) ntl => tl % next if ( allocated ( tl % toks )) deallocate ( tl % toks ) deallocate ( tl ) tl => ntl end do if (. not . associated ( lo )) then object_table ( idx )% ptr => o % next else lo % next => o % next end if deallocate ( o ) end if end subroutine draw_delobj !> !!##NAME !!    genobj(3f) - [M_draw:OBJECT] Returns a unique object identifier. !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!         integer function genobj() !!##DESCRIPTION !!    Returns a unique object identifier. integer function draw_genobj () draw_genobj = omax omax = omax + 1 end function draw_genobj !> !!##NAME !!    getopenobj(3f) - [M_draw:OBJECT] Return the number of the current object. !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!         integer function getopenobj() !! !!##DESCRIPTION !!    Return the number of the current object. integer function draw_getopenobj () draw_getopenobj = obno end function draw_getopenobj !> !!##NAME !!    loadobj(3f) - [M_draw:OBJECT] Load the object in the file filename as object number n. !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!         subroutine loadobj(n, filename) !!         integer n !!         character*(*) filename !!##DESCRIPTION !!    Load the object in the file \"filename\" as object number n. !! !!##EXAMPLE !! !!   Sample program: !! !!    program demo_loadobj !!    ! test some object-related procedures !!    use M_draw !!    implicit none !!    integer                      :: env_len, idum !!    character(len=:),allocatable :: env !!       !------------------------------------------------------------ !!       ! make an object file, which would normally be !!       ! made by a separate program !!       call voutput('+') !!       call vinit('nil')   ! set up device !!       call makeobj(3) !!          call polyfill(.true.) !!          call color(D_GREEN) !!          call circle(0.0,0.0,4.0) !!       call closeobj() !!       call saveobj(3,\"circle.obj\") !!       call vexit() !!       !------------------------------------------------------------ !!       ! CURRENTLY: !!       ! with multiple vinit(3f) calls the environment variable is !!       ! not used without explicitly using it !!       call get_environment_variable('M_DRAW_OUTPUT',LENGTH=env_len) !!       if(env_len.ne.0)then !!          allocate(character(len=env_len) :: env) !!          call get_environment_variable('M_DRAW_OUTPUT',env) !!          call voutput(env) !!       endif !!       !------------------------------------------------------------ !!       call prefsize(300, 300) !!       call prefposition(100, 100) !!       call vinit(' ')   ! set up device !!       call ortho2(-5.1,5.3,-5.2,5.4) !!       call color(D_WHITE)  ! set current color !!       call clear()   ! clear screen to current color !!       call color(D_BLUE) !!       call move2(-5.0,-5.0) !!       call draw2(5.0,5.0) !!       call move2(-5.0,5.0) !!       call draw2(5.0,-5.0) !!       call loadobj(3,\"circle.obj\") !!       call callobj(3) !!       call translate(1.0,0.0,0.0) !!       call translate(0.0,1.0,0.0) !!       idum=getkey() ! wait for some input !!       call vexit()  !  set the screen back to its original state !!       !------------------------------------------------------------ !!    end program demo_loadobj subroutine draw_loadobj ( n , file ) integer , intent ( in ) :: n character ( len =* ), intent ( in ) :: file integer :: u , ios , idx , k , slen type ( TokList ), pointer :: tl type ( Object ), pointer :: o open ( newunit = u , file = trim ( file ), access = 'stream' , form = 'unformatted' , status = 'old' , action = 'read' , iostat = ios ) if ( ios /= 0 ) then write ( error_unit , '(A, A)' ) \"loadobject: unable to open object file \" , trim ( file ) return end if idx = obj_hash ( n ) allocate ( o , tl ) o % obno = n o % next => object_table ( idx )% ptr object_table ( idx )% ptr => o o % tlist => tl tl % next => null () read ( u ) tl % count allocate ( tl % toks ( tl % count )) do k = 1 , tl % count read ( u ) tl % toks ( k )% i , tl % toks ( k )% f , slen if ( slen > 0 ) then allocate ( character ( len = slen ) :: tl % toks ( k )% s ) read ( u ) tl % toks ( k )% s end if end do close ( u ) end subroutine draw_loadobj !> !!##NAME !!    saveobj(3f) - [M_draw:OBJECT] Save object number n into file filename. Does NOT save objects called inside object n. !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!         subroutine saveobj(n, filename) !!         integer,intent(in) :: n !!         character(len=*),intent(in) :: filename !! !!##DESCRIPTION !!    Save the object number n into the file filename. This call does not !!    save objects called inside object n. !! !!##EXAMPLE !! !!   Sample program: !! !!    program demo_saveobj !!    ! create object in file \"circle.obj\" for use with loadobj(3f) !!    use M_draw !!    implicit none !!    character(len=:),allocatable :: env !!    integer :: ipaws !!    integer :: env_len !!       call voutput('+')            ! ignore $M_DRAW_OUTPUT !!       call vinit('nil')            ! start graphics !!       call push() !!       ! !!       call makeobj(3)              ! create an object !!          call polyfill(.true.) !!          call color(D_GREEN) !!          call circle(0.0,0.0,10.0) !!          call polyfill(.false.) !!          call color(D_BLUE) !!          call linewidth(100) !!          call circle(0.0,0.0,4.0) !!       call closeobj() !!       ! !!       call saveobj(3,\"circle.obj\") ! save object to file !!       call pop() !!       call vexit()                 ! exit graphics !!       ! !!       !-------  now this could be a separate program to use object !!       ! !!       !------------------------------------------------------------ !!       ! CURRENTLY: !!       ! with multiple vinit(3f) calls the environment variable is !!       ! not used without explicitly using it !!       call get_environment_variable('M_DRAW_OUTPUT',LENGTH=env_len) !!       if(env_len.ne.0)then !!          allocate(character(len=env_len) :: env) !!          call get_environment_variable('M_DRAW_OUTPUT',env) !!          call voutput(env) !!       endif !!       !------------------------------------------------------------ !!       call vinit(' ')  ! set up device !!       call page(-100.0,100.0,-100.0,100.0) !!       call loadobj(100,\"circle.obj\") !!       ! translate x,y,z scale x,y,z rotate x,y,z object !!       call invokeobj(   0.0,  0.0, 0.0,1.0,1.0,1.0,0.0,0.0,0.0, 100) !!       call invokeobj( -20.0,-20.0, 0.0,1.0,2.0,1.0,0.0,0.0,0.0, 100) !!       call invokeobj(  30.0, 40.0, 0.0,2.0,2.0,1.0,0.0,0.0,0.0, 100) !!       ipaws=getkey() !!       call vexit() ! set the screen back to its original state !!       ! !!    end program demo_saveobj subroutine draw_saveobj ( n , file ) integer , intent ( in ) :: n character ( len =* ), intent ( in ) :: file integer :: u , ios , idx , count , k , slen type ( Object ), pointer :: o type ( TokList ), pointer :: tl open ( newunit = u , file = trim ( file ), access = 'stream' , form = 'unformatted' , status = 'replace' , action = 'write' , iostat = ios ) if ( ios /= 0 ) then write ( error_unit , '(A, A)' ) \"saveobject: unable to open object file \" , trim ( file ) return end if idx = obj_hash ( n ) o => object_table ( idx )% ptr do while ( associated ( o )) if ( o % obno == n ) exit o => o % next end do if (. not . associated ( o )) then close ( u ); return end if count = 0 tl => o % tlist do while ( associated ( tl )) count = count + tl % count tl => tl % next end do write ( u ) count tl => o % tlist do while ( associated ( tl )) do k = 1 , tl % count if ( allocated ( tl % toks ( k )% s )) then slen = len ( tl % toks ( k )% s ) else slen = 0 end if write ( u ) tl % toks ( k )% i , tl % toks ( k )% f , slen if ( slen > 0 ) write ( u ) tl % toks ( k )% s end do tl => tl % next end do close ( u ) end subroutine draw_saveobj subroutine draw_doarc ( x , y , xoff , yoff , cosine , sine , nsegs ) real ( real32 ), intent ( in ) :: x , y , xoff , yoff , cosine , sine integer , intent ( in ) :: nsegs real ( real32 ) :: cx , cy , dx , dy integer :: i cx = x + xoff ; cy = y + yoff call draw_move2 ( cx , cy ) do i = 1 , nsegs dx = cx - x ; dy = cy - y cx = x + dx * cosine - dy * sine cy = y + dx * sine + dy * cosine call draw_draw2 ( cx , cy ) end do end subroutine draw_doarc !> !!##NAME !!    callobj(3f) - [M_draw:OBJECT] Draw object number n. !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!         subroutine callobj(n) !!         integer n !!##DESCRIPTION !!    Draw object number n. !!##EXAMPLE !! !!   Sample program: !! !!    program demo_callobj !!       use M_draw !!       implicit none !!       integer :: ipaws !!       integer :: ix, iy !!       real    :: x, y !!       integer :: icolor !! !!       ! set up graphics area !!       call prefsize(680,680) !!       call vinit(' ') ! start graphics using device $M_DRAW_DEVICE !!       !! Background color !!       !call color(D_WHITE) !!       !! Page setup !!       !call page(0.0,2124.0,0.0,2124.0) !!       !call color(D_BLACK) !! !!       call makeobj(1111) !!       call circleprecision(300) !!       call curveprecision(300) !! !!       icolor=0 !!       call mapcolor(icolor, 0, 0, 0); icolor=icolor+1 !!       call mapcolor(icolor, 0, 0, 255); icolor=icolor+1 !!       call mapcolor(icolor, 0, 255, 0); icolor=icolor+1 !!       call mapcolor(icolor, 0, 255, 255); icolor=icolor+1 !!       call mapcolor(icolor, 255, 0, 0); icolor=icolor+1 !!       call mapcolor(icolor, 255, 0, 255); icolor=icolor+1 !!       call mapcolor(icolor, 255, 255, 0); icolor=icolor+1 !!       call mapcolor(icolor, 255, 255, 255); icolor=icolor+1 !!       call mapcolor(icolor, 0, 0, 142); icolor=icolor+1 !!       call mapcolor(icolor, 0, 0, 175); icolor=icolor+1 !!       call mapcolor(icolor, 0, 0, 209); icolor=icolor+1 !!       call mapcolor(icolor, 135, 206, 255); icolor=icolor+1 !!       call mapcolor(icolor, 0, 142, 0); icolor=icolor+1 !!       call mapcolor(icolor, 0, 175, 0); icolor=icolor+1 !!       call mapcolor(icolor, 0, 209, 0); icolor=icolor+1 !!       call mapcolor(icolor, 0, 142, 142); icolor=icolor+1 !!       call mapcolor(icolor, 0, 175, 175); icolor=icolor+1 !!       call mapcolor(icolor, 0, 209, 209); icolor=icolor+1 !!       call mapcolor(icolor, 142, 0, 0); icolor=icolor+1 !!       call mapcolor(icolor,