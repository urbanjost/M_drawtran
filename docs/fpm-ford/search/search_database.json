 = 0 pgroup = groupid ; groupid = groupid + 1 ; drawn = 0 MIF_init = 1 end function MIF_init subroutine closeline () if ( polyopen ) then write ( draw_unit , '(A)' ) \"> #end curve PL\" polyopen = . false .; points = 0 end if end subroutine closeline subroutine openline () if (. not . polyopen ) then write ( draw_unit , '(A)' ) \"<PL\" write ( draw_unit , '(A, I0, A)' ) \" <GID \" , groupid , \" >\" members = members + 1 write ( draw_unit , '(A)' ) \" <SN>\" write ( draw_unit , '(A, F0.6, A)' ) \" <PW \" , curwid * real ( vdevice % sizeX , real32 ) / 1000 0.0_real32 / MIFTORAS , \">\" write ( draw_unit , '(A, I0, A)' ) \" <S \" , curcol , \" >\" call printcolor ( curcol4 ) write ( draw_unit , '(A)' ) \" <F 15 >\" polyopen = . true . end if end subroutine openline subroutine groupem () if ( members == 1 ) then write ( draw_unit , '(A)' ) \"<PL\" write ( draw_unit , '(A, I0, A)' ) \" <GID \" , groupid , \" >\" write ( draw_unit , '(A, F0.2, 1X, F0.2, A)' ) \" <P \" , kludgex , kludgey , \" >\" write ( draw_unit , '(A)' ) \"> #end curve PL\" write ( draw_unit , '(A, I0, A, I0, A)' ) \" <G <ID \" , groupid , \"> <GID \" , pgroup , \">>\" members = 0 ; groupid = groupid + 1 else if ( members /= 0 ) then write ( draw_unit , '(A, I0, A, I0, A)' ) \" <G <ID \" , groupid , \"> <GID \" , pgroup , \">>\" members = 0 ; groupid = groupid + 1 end if end subroutine groupem integer function MIF_exit () call closeline () call groupem () write ( draw_unit , '(A, I0, A)' ) \" <G <ID \" , pgroup , \"> >\" write ( draw_unit , '(A)' ) \"> #end of Page\" write ( draw_unit , '(A)' ) \"# End of MIFFile\" pgroup = groupid ; groupid = groupid + 1 drawn = 0 ; points = 0 if ( draw_unit /= output_unit . and . draw_unit /= error_unit ) then flush ( draw_unit ) close ( draw_unit ) end if MIF_exit = 0 end function MIF_exit integer function MIF_draw ( x , y ) integer , intent ( in ) :: x , y real ( real32 ) :: realx , realy , realx0 , realy0 realx = real ( x , real32 ) / MIFTORAS + borderx realy = real ( vdevice % sizeSy - y , real32 ) / MIFTORAS + bordery realx0 = real ( vdevice % cpVx , real32 ) / MIFTORAS + borderx realy0 = real ( vdevice % sizeSy - vdevice % cpVy , real32 ) / MIFTORAS + bordery if ( pslstx /= vdevice % cpVx . or . pslsty /= vdevice % cpVy . or . points >= MAXPOINTS ) then call closeline () call openline () write ( draw_unit , '(A, F0.2, 1X, F0.2, A)' ) \" <P \" , realx0 , realy0 , \" >\" kludgex = realx0 ; kludgey = realy0 ; points = 1 end if call openline () write ( draw_unit , '(A, F0.2, 1X, F0.2, A)' ) \" <P \" , realx , realy , \" >\" points = points + 1 pslstx = x ; pslsty = y ; drawn = 1 MIF_draw = 0 end function MIF_draw integer function MIF_clear () call closeline () if ( drawn /= 0 ) then call groupem () write ( draw_unit , '(A, I0, A)' ) \" <G <ID \" , pgroup , \"> >\" write ( draw_unit , '(A)' ) \"> #end of Page\" write ( draw_unit , '(A)' ) \"<Page\" write ( draw_unit , '(A, F0.6, 1X, F0.6, A)' ) \"<PageSize  \" , MIFXSIZE0 , MIFYSIZE0 , \" >\" pgroup = groupid ; groupid = groupid + 1 end if drawn = 0 ; points = 0 MIF_clear = 0 end function MIF_clear integer function MIF_color ( col ) integer , intent ( in ) :: col integer :: c_idx call closeline () if ( col < 0 ) then curwid = real ( abs ( col ), real32 ) else curcol4 = mod ( col , CMAPSIZE ) c_idx = mod ( col , min ( 256 , CMAPSIZE )) curcol = cmap ( mod ( c_idx , 8 ) + 1 ) if ( MIFVERSION == 4 ) then curpat = c_idx / CMAPSIZE else curpat = c_idx / 16 end if end if call groupem () MIF_color = 0 end function MIF_color integer function MIF_setlw ( width ) integer , intent ( in ) :: width call closeline () curwid = real ( abs ( width ), real32 ) call groupem () MIF_setlw = 0 end function MIF_setlw integer function MIF_font ( font ) character ( len =* ), intent ( in ) :: font if ( trim ( font ) == \"small\" ) then vdevice % hwidth = 1 2.0_real32 / 7 2.0_real32 / 0.03937_real32 * MIFTORAS vdevice % hheight = vdevice % hwidth * 2.2_real32 else if ( trim ( font ) == \"large\" ) then