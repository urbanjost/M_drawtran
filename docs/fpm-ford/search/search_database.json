eal32 ) + 0.5_real32 ) if (( yprevious <= y1 . and . y2 <= y1 ) . or . ( yprevious >= y1 . and . y2 >= y1 )) then PPM_YINTERCEPT = 1 ; return else PPM_YINTERCEPT = 0 ; return end if end if PPM_YINTERCEPT = 0 end function PPM_YINTERCEPT subroutine PPM_SOLID_FILL ( n , x , y ) integer , intent ( in ) :: n integer , intent ( in ) :: x ( n ), y ( n ) integer :: i , j , yhorizontal , xint , tmp , ymin , ymax , xi ( MAXVERTS ), yprev logical :: sorted if ( n > MAXVERTS ) then write ( error_unit , '(A, I0, A)' ) \"*PPM_SOLID_FILL* more than \" , MAXVERTS , \" vertices in a polygon\" return end if ymin = max ( minval ( y ( 1 : n )), 0 ) ymax = min ( maxval ( y ( 1 : n )), Y_SIZE ) yhorizontal = ymax do while ( yhorizontal >= ymin ) j = 0 yprev = y ( n ) do i = 1 , n - 1 if ( PPM_YINTERCEPT ( yhorizontal , x ( i ), y ( i ), x ( i + 1 ), y ( i + 1 ), xint , yprev ) /= 0 ) then j = j + 1 ; xi ( j ) = xint end if end do if ( PPM_YINTERCEPT ( yhorizontal , x ( n ), y ( n ), x ( 1 ), y ( 1 ), xint , yprev ) /= 0 ) then j = j + 1 ; xi ( j ) = xint end if sorted = . false . do while (. not . sorted ) sorted = . true . do i = 1 , j - 1 if ( xi ( i ) > xi ( i + 1 )) then tmp = xi ( i ); xi ( i ) = xi ( i + 1 ); xi ( i + 1 ) = tmp sorted = . false . end if end do end do do i = 1 , j - 1 , 2 GLOBAL_lastx = max ( 0 , min ( xi ( i ), X_SIZE )) GLOBAL_lasty = yhorizontal call PPM_DRAW_LINE ( max ( 0 , min ( xi ( i + 1 ), X_SIZE )), yhorizontal ) end do yhorizontal = yhorizontal - 1 end do end subroutine PPM_SOLID_FILL subroutine PPM_ENDCAP_CIRCLE ( x , y ) integer , intent ( in ) :: x , y integer , parameter :: nsegs = 15 real ( real32 ) :: cx , cy , dx , dy , angle , cosine , sine integer :: cxras ( nsegs ), cyras ( nsegs ), i angle = 2.0_real32 * PI / real ( nsegs , real32 ) cosine = cos ( angle ); sine = sin ( angle ) cx = real ( x , real32 ) + real ( GLOBAL_rasters , real32 ) / 2.0_real32 cy = real ( y , real32 ) cxras ( 1 ) = int ( cx ); cyras ( 1 ) = int ( cy ) do i = 2 , nsegs dx =