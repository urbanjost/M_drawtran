d_str ( buf , pos , str ) character ( len = :), allocatable , intent ( inout ) :: buf integer , intent ( inout ) :: pos character ( len =* ), intent ( in ) :: str character ( len = :), allocatable :: tmp integer :: n , need n = len ( str ) if ( n == 0 ) return need = pos + n if (. not . allocated ( buf )) then allocate ( character ( len = max ( 65536 , need * 2 )) :: buf ) else if ( need > len ( buf )) then allocate ( character ( len = max ( len ( buf ) * 2 , need * 2 )) :: tmp ) tmp ( 1 : pos ) = buf ( 1 : pos ) call move_alloc ( tmp , buf ) end if buf ( pos + 1 : need ) = str pos = need end subroutine append_str subroutine append_sixel_run ( buf , pos , ch , count ) character ( len = :), allocatable , intent ( inout ) :: buf integer , intent ( inout ) :: pos character ( len = 1 ), intent ( in ) :: ch integer , intent ( in ) :: count character ( len = 24 ) :: rle if ( count <= 3 ) then call append_str ( buf , pos , repeat ( ch , count )) else write ( rle , '(A,I0,A)' ) '!' , count , ch call append_str ( buf , pos , trim ( rle )) end if end subroutine append_sixel_run end module m_draw_drv_sixel","tags":"","url":"sourcefile/m_draw_drv_sixel.f90.html"},{"title":"m_draw_matrix.f90 – M_drawtran","text":"Source Code module m_draw_matrix use , intrinsic :: iso_fortran_env , only : real32 , output_unit use m_draw_types use m_draw_verror implicit none private public :: draw_copyvector , draw_copymatrix , draw_copytranspose , & draw_getmatrix , draw_pushmatrix , draw_popmatrix , & draw_loadmatrix , draw_mult4x4 , draw_multmatrix , & draw_identmatrix , draw_multvector , draw_premultvector , & draw_printmat , draw_printvect type ( Mstack ), pointer , save :: msfree => null () interface function draw_newtokens ( num ) result ( toks ) import :: Token integer , intent ( in ) :: num type ( Token ), pointer :: toks (:) end function draw_newtokens end interface contains subroutine draw_copyvector ( a , b ) real ( real32 ), intent ( out ) :: a ( 4 ) real ( real32 ), intent ( in ) :: b ( 4 ) a = b end subroutine draw_copyvector subroutine draw_copymatrix ( a , b ) real ( real32 ), intent ( out ) :: a ( 4 , 4 ) real ( real32 ), intent ( in ) :: b ( 4 , 4 ) a = b end subroutine draw_copymatrix subroutine draw_copytranspose ( a , b ) real ( real32 ), intent ( out ) :: a ( 4 , 4 ) real ( real32 ), intent ( in ) :: b ( 4 , 4 ) a = transpose ( b ) end subroutine draw_copytranspose subroutine draw_getmatrix ( m ) real ( real32 ), intent ( out ) :: m ( 4 , 4 ) call draw_copymatrix ( m , vdevice % transmat % m ) end subroutine draw_getmatrix !> !!##NAME !!    pushmatrix(3f) - [M_draw:MATRIX_STACK] Save the current transformation matrix on the matrix stack. !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!          subroutine pushmatrix() !! !!##DESCRIPTION !! !!    Save the current transformation matrix on the matrix stack. subroutine draw_pushmatrix () type ( Mstack ), pointer :: tmpmat type ( Token ), pointer :: p (:) if ( vdevice % inobject /= 0 ) then p => draw_newtokens ( 1 ) p ( 1 )% i = OBJ_PUSHMATRIX return end if if ( associated ( msfree )) then tmpmat => vdevice % transmat vdevice % transmat => msfree msfree => msfree % back vdevice % transmat % back => tmpmat call draw_copymatrix ( vdevice % transmat % m , tmpmat % m ) else allocate ( tmpmat ) tmpmat % back => vdevice % transmat call draw_copymatrix ( tmpmat % m , vdevice % transmat % m ) vdevice % transmat => tmpmat end if end subroutine draw_pushmatrix !> !!##NAME !!    popmatrix(3f) - [M_draw:MATRIX_STACK] Reinstall the last matrix pushed !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!          subroutine popmatrix() !! !!##DESCRIPTION !! !!    Retrieve the last matrix pushed and make it the current transformation matrix. subroutine draw_popmatrix () type ( Token ), pointer :: p (:) type ( Mstack ), pointer :: oldtop if ( vdevice % inobject /= 0 ) then p => draw_newtokens ( 1 ) p ( 1 )% i = OBJ_POPMATRIX return end if if (. not . associated ( vdevice % transmat % back )) then call draw_verror ( \"popmatrix: matrix stack empty\" ) else oldtop => vdevice % transmat vdevice % transmat => vdevice % transmat % back oldtop % back => msfree msfree => oldtop end if vdevice % cpVvalid = 0 end subroutine draw_popmatrix subroutine draw_loadmatrix ( mat ) real ( real32 ), intent ( in ) :: mat ( 4 , 4 ) integer :: i , j , k type ( Token ), pointer :: p (:) if ( vdevice % initialized == 0 ) then call draw_verror ( \"loadmatrix: draw not initialized\" ) end if if ( vdevice % inobject /= 0 ) then p => draw_newtokens ( 17 ) p ( 1 )% i = OBJ_LOADMATRIX k = 2 do i = 1 , 4 do j = 1 , 4 p ( k )% f = mat ( i , j ) k = k + 1 end do end do return end if vdevice % transmat % m = mat vdevice % cpVvalid = 0 end subroutine draw_loadmatrix subroutine draw_mult4x4 ( a , b , c ) real ( real32 ), intent ( out ) :: a ( 4 , 4 ) real ( real32 ), intent ( in ) :: b ( 4 , 4 ), c ( 4 , 4 ) a = matmul ( b , c ) end subroutine draw_mult4x4 subroutine draw_multmatrix ( mat ) real ( real32 ), intent ( in ) :: mat ( 4 , 4 ) real ( real32 ) :: prod ( 4 , 4 ) type ( Token ), pointer :: p (:) integer :: i , j , k if ( vdevice % inobject /= 0 ) then p => draw_newtokens ( 17 ) p ( 1 )% i = OBJ_MULTMATRIX k = 2 do i = 1 , 4 do j = 1 , 4 p ( k )% f = mat ( i , j ) k = k + 1 end do end do return end if call draw_mult4x4 ( prod , mat , vdevice % transmat % m ) call draw_loadmatrix ( prod ) end subroutine draw_multmatrix subroutine draw_identmatrix ( a ) real ( real32 ), intent ( out ) :: a ( 4 , 4 ) integer :: i a = 0.0_real32 do i = 1 , 4 a ( i , i ) = 1.0_real32 end do end subroutine draw_identmatrix subroutine draw_multvector ( v , a , b ) real ( real32 ), intent ( out ) :: v ( 4 ) real ( real32 ), intent ( in ) :: a ( 4 ), b ( 4 , 4 ) v ( 1 ) = a ( 1 ) * b ( 1 , 1 ) + a ( 2 ) * b ( 2 , 1 ) + a ( 3 ) * b ( 3 , 1 ) + a ( 4 ) * b ( 4 , 1 ) v ( 2 ) = a ( 1 ) * b ( 1 , 2 ) + a ( 2 ) * b ( 2 , 2 ) + a ( 3 ) * b ( 3 , 2 ) + a ( 4 ) * b ( 4 , 2 ) v ( 3 ) = a ( 1 ) * b ( 1 , 3 ) + a ( 2 ) * b ( 2 , 3 ) + a ( 3 ) * b ( 3 , 3 ) + a ( 4 ) * b ( 4 , 3 ) v ( 4 ) = a ( 1 ) * b ( 1 , 4 ) + a ( 2 ) * b ( 2 , 4 ) + a ( 3 ) * b ( 3 , 4 ) + a ( 4 ) * b ( 4 , 4 ) end subroutine draw_multvector subroutine draw_premultvector ( v , a , b ) real ( real32 ), intent ( out ) :: v ( 4 ) real ( real32 ), intent ( in ) :: a ( 4 ), b ( 4 , 4 ) v ( 1 ) = a ( 1 ) * b ( 1 , 1 ) + a ( 2 ) * b ( 1 , 2 ) + a ( 3 ) * b ( 1 , 3 ) + a ( 4 ) * b ( 1 , 4 ) v ( 2 ) = a ( 1 ) * b ( 2 , 1 ) + a ( 2 ) * b ( 2 , 2 ) + a ( 3 ) * b ( 2 , 3 ) + a ( 4 ) * b ( 2 , 4 ) v ( 3 ) = a ( 1 ) * b ( 3 , 1 ) + a ( 2 ) * b ( 3 , 2 ) + a ( 3 ) * b ( 3 , 3 ) + a ( 4 ) * b ( 3 , 4 ) v ( 4 ) = a ( 1 ) * b ( 4 , 1 ) + a ( 2 ) * b ( 4 , 2 ) + a ( 3 ) * b ( 4 , 3 ) + a ( 4 ) * b ( 4 , 4 ) end subroutine draw_premultvector subroutine draw_printmat ( s , m ) character ( len =* ), intent ( in ) :: s real ( real32 ), intent ( in ) :: m ( 4 , 4 ) integer :: i write ( output_unit , '(A)' ) trim ( s ) do i = 1 , 4 write ( output_unit , '(4F12.6)' ) m ( i , 1 : 4 ) end do end subroutine draw_printmat subroutine draw_printvect ( s , v ) character ( len =* ), intent ( in ) :: s real ( real32 ), intent ( in ) :: v ( 4 ) write ( output_unit , '(A, 1X, 4F12.6)' ) trim ( s ), v ( 1 : 4 ) end subroutine draw_printvect end module m_draw_matrix","tags":"","url":"sourcefile/m_draw_matrix.f90.html"},{"title":"m_draw_text.f90 – M_drawtran","text":"Source Code module m_draw_text use , intrinsic :: iso_fortran_env , only : real32 , real64 , int8 , error_unit use m_draw_types use m_draw_verror use m_draw_matrix use m_draw_mapping use m_draw_move use m_draw_draw use m_draw_attr implicit none private public :: draw_font , draw_numchars , draw_hershfont , draw_getcharsize , & draw_drawchar , draw_textsize , draw_getfontwidth , draw_getfontheight , & draw_getfontdec , draw_getfontasc , draw_getfontsize , draw_drawstr , & draw_strlength , draw_boxtext , draw_boxfit , draw_centertext , & draw_textjustify , draw_xcentertext , draw_ycentertext , & draw_leftjustify , draw_rightjustify , draw_topjustify , & draw_bottomjustify , draw_fixedwidth , draw_textang , & draw_textslant , draw_textweight interface draw_centertext module procedure draw_centertext_integer module procedure draw_centertext_logical end interface draw_centertext interface draw_fixedwidth module procedure draw_fixedwidth_integer module procedure draw_fixedwidth_logical end interface draw_fixedwidth interface draw_drawchar module procedure draw_drawchar_integer module procedure draw_drawchar_character end interface draw_drawchar real ( real32 ), save :: SCSIZEX = 1.0_real32 , SCSIZEY = 1.0_real32 integer , save :: Loaded = 0 , nchars = 0 type :: font_table_t integer ( int8 ), allocatable :: p (:) integer , allocatable :: ind (:) integer :: as = 0 , dec = 0 , mw = 0 end type font_table_t type ( font_table_t ), save :: ftab real ( real32 ), parameter :: btab_x ( 5 ) = [ 0.0_real32 , 0.5_real32 , 0.0_real32 , 1.0_real32 , 1.0_real32 ] real ( real32 ), parameter :: btab_y ( 5 ) = [ 0.0_real32 , 0.5_real32 , 1.0_real32 , 1.0_real32 , 0.0_real32 ] interface function draw_newtokens ( num ) result ( toks ) import :: Token integer , intent ( in ) :: num type ( Token ), pointer :: toks (:) end function draw_newtokens end interface contains pure integer function xcoord ( val ) integer , intent ( in ) :: val xcoord = val - ichar ( 'R' ) end function xcoord pure integer function ycoord ( val ) integer , intent ( in ) :: val ycoord = ichar ( 'R' ) - val end function ycoord pure integer function skew_x ( x , y ) integer , intent ( in ) :: x , y skew_x = int ( real ( x , real32 ) + vdevice % attr % a % skew * real ( y , real32 )) end function skew_x pure function basename ( path ) result ( base ) character ( len =* ), intent ( in ) :: path character ( len = :), allocatable :: base integer :: idx idx = max ( index ( path , '/' , back = . true .), index ( path , '\\', back=.true.)) if (idx > 0 .and. idx < len(path)) then base = path(idx+1:) else base = path end if end function basename !> !! !!##NAME !!    font(3f) - [M_draw:TEXT] Set the current font by name !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!         subroutine font(fontname) !!         character(len=*),intent(in) :: fontname !! !!##DESCRIPTION !!    Set the current font. !! !!    M_draw supports hardware and software fonts. The software fonts are based !!    on the character set digitized by Dr Allen V. Hershey while working at !!    the U. S. National Bureau of Standards. Exactly what hardware fonts are !!    supported depends on the device, but it is guaranteed that the names !!    \"large\" and \"small\" will result in something readable. For X11 displays !!    the default large and small fonts used by the program can be overridden !!    by placing the following defaults in the ~/.Xdefaults file: !! !!      draw.smallfont: X11-font-name !!      draw.largefont: X11-font-name !! !!    It is noted here that hardware text is always assumed to be drawn !!    parallel to the (x, y) plane, using whatever the current z coordinate !!    is. The following software fonts are supported: !! !!       astrology       cursive         cyrillic        futura.l !!       futura.m        gothic.eng      gothic.ger      gothic.ita !!       greek           markers         math.low        math.upp !!       meteorology     music           script          symbolic !!       times.g         times.i         times.ib        times.r !!       times.rb        japanese !! !!    A markers font \"markers\" is also provided for doing markers - you need !!    to have centertext mode on for this to give sensible results when placing !!    the markers. !! !!    If the environment variable \"M_DRAW_FONTPATH\" is set M_draw looks for the software !!    fonts in the directory given by this value. !! !!    WHEN ASKED FOR NON-EXISTENT FONT NAMES, FONT(3f) STOPS THE PROGRAM. !! !!##EXAMPLE !! !!   Sample Program: !! !!    program demo_font !!    use :: M_draw !!    use M_draw,    only  : D_BLACK,   D_WHITE !!    use M_draw,    only  : D_RED,     D_GREEN,    D_BLUE !!    use M_draw,    only  : D_YELLOW,  D_MAGENTA,  D_CYAN !!    implicit none !!    real    :: left !!    real    :: baseline=80.0 !!    integer :: icolor=1 !!    integer :: ipaws !!       !! set up drawing surface !!       call prefsize(400, 400) !!       call vinit(' ') ! start graphics using device $M_DRAW_DEVICE !!       call page(-100.0, 100.0, -100.0, 100.0) !!       call color(D_WHITE) !!       call clear() !!       call textsize(10.0, 10.0) !!       !! place a vertical line along the edge !!       call color(D_RED) !!       call move2(-90.0, -90.0) !!       call draw2(-90.0, 90.0) !!       !! make a centered title at top a bit bolder and bigger !!       call xcentertext() !!       call textsize(13.0, 13.0) !!       call linewidth(90) !!       left=0 !!       call nextline(' Font Samples ') !!       !! print the font samples !!       left=-90 !!       call linewidth(40) !!       call textsize(10.0, 10.0) !!       call centertext(.false.) !!       icolor=icolor-1 !!       call nextline(' DEFAULT ( ie . futura . l ) ') !!       icolor=icolor-1 !!       call nextline(' now call font ( 3 f ) ... ') !!       call nextline(' A nice SIMPLEX font , futura . l ') !!       call nextline(' A COMPLEX font , times . r ') !!       call nextline(' ITALIC letters , times . i ') !!       call nextline(' DUPLEX is in between , futura . m ') !!       ipaws=getkey() !!       call vexit() !!    contains !!    subroutine nextline(string) !!    character(len=*) :: string !!    !! reduce some duplicate code; very specific to this EXAMPLE !!       integer :: iend !!       iend=index(string,' , ')  ! if comma, assume font name found !!       write(*,*)' FONT = ',string(iend+1:),iend !!       if(iend.ne.0)call font(trim(adjustl(string(iend+1:)))) ! change font !!       icolor=icolor+1         ! set pen color !!       call color(icolor) !!       baseline=baseline-20    ! move down before drawing line !!       call move2(left, baseline) !!       call drawstr(string)    ! draw string !!    end subroutine nextline !! !!    end program demo_font recursive subroutine draw_font(name) character(len=*), intent(in) :: name type(Token), pointer :: tok(:) character(len=:), allocatable :: leaf if (vdevice%initialized == 0) call draw_verror(\"font: draw not initialized\") if (vdevice%inobject /= 0) then tok => draw_newtokens(2) tok(1)%i = OBJ_FONT tok(2)%s = trim(name) return end if leaf = basename(trim(name)) if (leaf == trim(vdevice%attr%a%font)) return vdevice%attr%a%softtext = REALHARDWARE if (draw_hershfont(trim(name)) /= 0) then vdevice%attr%a%softtext = HERSHEY return else if (trim(name) == \"large\") then if (vdevice%dev%Vfont(trim(vdevice%dev%large)) == 0) call draw_verror(\"font: unable to open large font\") else if (trim(name) == \"small\") then if (vdevice%dev%Vfont(trim(vdevice%dev%small)) == 0) call draw_verror(\"font: unable to open small font\") else if (vdevice%dev%Vfont(trim(name)) == 0) then write(error_unit, ' ( A ) ') \"font: unable to open fontfile \" // trim(name) call draw_font(\"large\") return end if if (vdevice%attr%a%softtext == SOFTHARDWARE) then call draw_textsize(vdevice%attr%a%fontwidth, vdevice%attr%a%fontheight) end if vdevice%attr%a%font = leaf end subroutine draw_font !> !!##NAME !!    numchars(3f) - [M_draw:TEXT] Return number of characters in the current SOFTWARE font. !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!         integer function numchars() !! !!##DESCRIPTION !!    Return the number of characters in the current font. Applicable only to !!    software fonts. integer function draw_numchars() draw_numchars = merge(nchars, 128, vdevice%attr%a%softtext == HERSHEY) end function draw_numchars integer function draw_hershfont(fontname) character(len=*), intent(in) :: fontname integer :: u, ios, i, nvects, n, pos_idx, env_len character(len=512) :: path, flib logical :: exists call get_environment_variable(\"M_DRAW_FONTPATH\", value=flib, length=env_len, status=ios) if (ios /= 0 .or. env_len == 0) then path = FONTLIB // trim(fontname) else path = trim(flib) // \"/\" // trim(fontname) end if inquire(file=trim(path), exist=exists) if (.not. exists) then path = trim(fontname) inquire(file=trim(path), exist=exists) if (.not. exists) then draw_hershfont = 0 return end if end if open(newunit=u, file=trim(path), access=' stream ', form=' unformatted ', status=' old ', action=' read ', iostat=ios) if (ios /= 0) then; draw_hershfont = 0; return; end if read(u, iostat=ios) nchars, nvects, ftab%as, ftab%dec, n if (ios /= 0) then; close(u); draw_hershfont = 0; return; end if ftab%mw = int(real(n, real32) + vdevice%attr%a%skew * real(ftab%as, real32)) if (Loaded /= 0) then if (allocated(ftab%p)) deallocate(ftab%p) if (allocated(ftab%ind)) deallocate(ftab%ind) Loaded = 0 end if allocate(ftab%ind(nchars + 1), ftab%p(2 * nvects)) pos_idx = 1 do i = 1, nchars read(u, iostat=ios) n if (ios /= 0) then; close(u); draw_hershfont = 0; return; end if if (n > 0) then read(u, iostat=ios) ftab%p(pos_idx : pos_idx + n - 1) if (ios /= 0) then; close(u); draw_hershfont = 0; return; end if end if ftab%ind(i) = pos_idx pos_idx = pos_idx + n end do ftab%ind(nchars + 1) = pos_idx close(u) Loaded = 1 vdevice%attr%a%softtext = Loaded vdevice%attr%a%font = basename(trim(fontname)) draw_hershfont = 1 end function draw_hershfont !> !!##NAME !!    getcharsize(3f) - [M_draw:TEXT] Get the width and height of a character. !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!         subroutine getcharsize(c, width, height) !!         character*1 c !!         real width, height !! !!##DESCRIPTION !!    Get the width and height of a character. At the moment the height !!    returned is always that of the difference between the maximum descender !!    and ascender. subroutine draw_getcharsize(c, width, height) character(len=1), intent(in) :: c real(real32), intent(out)    :: width, height integer :: i, ii, idx_start real(real32) :: a, b real(real32), parameter :: fudge = 0.0123_real32 if (vdevice%initialized == 0) call draw_verror(\"getcharsize: draw not initialized\") if (vdevice%attr%a%softtext == HERSHEY) then if (Loaded == 0) call draw_verror(\"getcharsize: no software font loaded\") height = real(ftab%as - ftab%dec, real32) * SCSIZEY if (vdevice%attr%a%fixedwidth /= 0) then width = real(ftab%mw, real32) * SCSIZEX else ii = max(1, min(nchars, ichar(c) - 32 + 1)) idx_start = ftab%ind(ii) width = real(int(ftab%p(idx_start + 1)) - int(ftab%p(idx_start)), real32) * SCSIZEX end if else if (vdevice%attr%a%softtext == SOFTHARDWARE) then i = ichar(c) + 1 if (i >= 1 .and. i <= 128) then width = hardwidth(i) * draw_getfontwidth() height = draw_getfontheight() else height = 0.0_real32; width = 0.0_real32 end if else if (vdevice%attr%a%softtext == REALHARDWARE) then call draw_VtoWxy(vdevice%hwidth + fudge, vdevice%hheight + fudge, width, height) call draw_VtoWxy(fudge, fudge, a, b) height = height - b; width = width - a end if end subroutine draw_getcharsize !> !!##NAME !!    drawchar(3f) - [M_draw:TEXT] Draw the character c and update current position. !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!         subroutine drawchar(ch) !!         character(len=1),intent(in) :: ch !! !!##DESCRIPTION !! !!    Draw the character c at the current position. The current graphics !!    position represents the bottom left hand corner of the character space. !! !!    Uses current line color and thickness and text justification mode. !! !!##EXAMPLE !! !!   Sample program: !! !!    program demo_drawchar !!    ! !!    !      display all the hershey fonts and demonstrate textang !!    ! !! !!    use M_draw, only: vinit, vsetflush, color, clear, font, vexit, vflush !!    use M_draw, only: ortho2, textang, boxtext, rect, textsize, getkey !!    use M_draw,    only  : D_BLACK,   D_WHITE !!    use M_draw,    only  : D_RED,     D_GREEN,    D_BLUE !!    use M_draw,    only  : D_YELLOW,  D_MAGENTA,  D_CYAN !!    use M_draw !!    implicit none !! !!    character(len=40)   :: str1, str2, str3, str4, fonts(22) !!    character(len=100)  :: buf !!    character(len=1)    :: c !!    integer             :: i, ios !!    data fonts/ ' astrology ', ' cursive ',    ' futura . l ',               & !!    &      ' futura . m ',  ' gothic . eng ', ' gothic . ger ',             & !!    &      ' gothic . ita ',' greek ',      ' japanese ',    ' markers ', & !!    &      ' math . low ',  ' math . upp ',   ' meteorology ', ' music ',   & !!    &      ' cyrillic ',  ' script ',     ' symbolic ',    ' times . g ', & !!    &      ' times . ib ',  ' times . i ',    ' times . r ',     ' times . rb ' / !! !!    data str1/ ' ABCDEFGHIJKLMNOPQRSTUVWXYZ ' / !!    data str2/ ' abcdefghijklmnopqrstuvwxyz ' / !!    data str3/ ' 1234567890 +-= !@#$%&#94;&*(){}[]' / !!    data str4/ '<>,./?~`\\|_BONK,blark' / !!    integer :: idum !!    print*,'Enter output device:' !!    read(*,'(a)',iostat=ios)buf !!    if(ios.ne.0)buf=' ' !!    call prefsize(1000,1000) !!    call vinit(buf) !!    call vsetflush(.false.) !!    call linewidth(20) !!    call clear() !!    ! define the world space !!    call ortho2(-14.0, 14.0, -14.0, 14.0) !!    do i = 1, 22 !!       ! do the title !!       call textang(0.0)   ! reset text angle so title is straight !!       call color(D_CYAN) !!       call font('futura.m') !!       write(buf, '(''This is Hershey font '',a)') fonts(i) !!       !call printattribs('before') !!       call boxtext(-11.0, 12.0, 20.0, 1.0, buf) !!       !call printattribs('after') !!       call rect(-11.0, 12.0, 9.0, 13.0) ! draw a box around the title !!       call font(fonts(i))               ! grab a font from the table !!       call color(D_BLUE) !!       ! show the outer ring !!       call textsize(1.5, 1.5) !!       call ShowCircularText(11.0, str1) !!       ! show the second ring !!       call textsize(1.3, 1.3) !!       call ShowCircularText(8.5, str2) !!       ! show the third ring !!       call textsize(1.1, 1.1) !!       call ShowCircularText(7.0, str3) !!       ! show the inside ring !!       call textsize(0.9, 0.9) !!       call ShowCircularText(5.0, str4) !!       call vflush() !! !!       idum= getkey() !!       select case(idum) !!        case(:-1,ichar('q'),ichar('Q')) !!          exit !!       end select !! !!       call color(D_BLACK) !!       call clear() !!    enddo !!    call vexit() !!    contains !! !!    subroutine ShowCircularText(r, str)  ! show a ring of text !!       use M_draw, only : move2, textang, drawchar !! !!       real              :: r !!       character(len=*)  :: str !!       real              :: i, inc, x, y, a !!       integer           :: j, i10 !!       character(len=1)  :: c !!       real,parameter    :: pi = 3.1415926535 !! !!       j = 1 !!       inc = 360.0 / len_trim(str) !! !!       i=0.0 !!       do i10 = 1,len_trim(str) !!          ! !!          ! calculate the next drawing position !!          c = str(j:j) !!          x = r * cos(i * pi / 180.0) !!          y = r * sin(i * pi / 180.0) !!          call move2(x, y) !!          ! !!          ! calculate angle for next character !!          a = 90.0 + i !!          ! !!          ! set the orientation of the next character !!          call textang(a) !!          ! !!          ! draw the character !!          call drawchar(c) !!          j = j + 1 !!          i=i+inc !!       enddo !! !!    end subroutine ShowCircularText !! !!    end program demo_drawchar subroutine draw_drawchar_integer ( c ) integer , intent ( in ) :: c integer :: p_idx , e_idx , idx_start , move_flag , b , i , x , y , xt , yt , sync real ( real32 ) :: xp , yp , tmp , xsave , ysave , tcos , tsin type ( Token ), pointer :: pr (:) if ( vdevice % inobject /= 0 ) then pr => draw_newtokens ( 2 ) pr ( 1 )% i = OBJ_DRAWCHAR pr ( 2 )% i = c return end if if ( vdevice % attr % a % softtext == SOFTHARDWARE ) then if ( vdevice % cpVvalid == 0 ) call draw_actual_move () call draw_drawhardchar ( char ( c )) if ( vdevice % attr % a % fixedwidth /= 0 ) then call draw_rmove ( draw_getfontwidth (), 0.0_real32 , 0.0_real32 ) else i = max ( 1 , min ( 128 , c + 1 )) call draw_rmove ( hardwidth ( i ) * draw_getfontwidth (), 0.0_real32 , 0.0_real32 ) end if return end if if ( vdevice % attr % a % softtext /= HERSHEY ) then if ( vdevice % cpVvalid == 0 ) call draw_actual_move () call draw_drawhardchar ( char ( c )) call draw_rmove ( draw_getfontwidth (), 0.0_real32 , 0.0_real32 ) return end if if ( Loaded == 0 ) call draw_verror ( \"drawchar: no font loaded\" ) sync = vdevice % sync if ( sync /= 0 ) vdevice % sync = 0 tcos = vdevice % attr % a % textcos tsin = vdevice % attr % a % textsin i = max ( 1 , min ( nchars , c - 32 + 1 )) xsave = vdevice % cpW ( D_X ) ysave = vdevice % cpW ( D_Y ) idx_start = ftab % ind ( i ) xt = merge ( - ftab % mw / 2 , xcoord ( int ( ftab % p ( idx_start ))), vdevice % attr % a % fixedwidth /= 0 ) yt = ftab % dec if ( iand ( vdevice % attr % a % justify , D_XCENTERED ) /= 0 ) then xt = 0 else if ( iand ( vdevice % attr % a % justify , D_RIGHT ) /= 0 ) then xt = merge ( ftab % mw / 2 , - xcoord ( int ( ftab % p ( idx_start ))), vdevice % attr % a % fixedwidth /= 0 ) end if if ( iand ( vdevice % attr % a % justify , D_YCENTERED ) /= 0 ) then yt = 0 else if ( iand ( vdevice % attr % a % justify , D_TOP ) /= 0 ) then yt = - ftab % dec end if e_idx = ftab % ind ( i + 1 ) b = 1 do move_flag = 1 p_idx = idx_start + 2 do while ( p_idx < e_idx ) x = xcoord ( int ( ftab % p ( p_idx ))) y = ycoord ( int ( ftab % p ( p_idx + 1 ))) p_idx = p_idx + 2 x = skew_x ( x , y ) if ( x /= - 50 ) then xp = ( btab_x ( b ) + real ( x - xt , real32 )) * SCSIZEX yp = ( btab_y ( b ) + real ( y - yt , real32 )) * SCSIZEY tmp = xp xp = tcos * tmp - tsin * yp + xsave yp = tsin * tmp + tcos * yp + ysave if ( move_flag /= 0 ) then move_flag = 0 call draw_move ( xp , yp , vdevice % cpW ( D_Z )) else call draw_draw ( xp , yp , vdevice % cpW ( D_Z )) end if else move_flag = 1 end if end do b = b + 1 if ( b > vdevice % attr % a % bold ) exit end do tmp = merge ( real ( ftab % mw , real32 ), & real ( int ( ftab % p ( idx_start + 1 )) - int ( ftab % p ( idx_start )), real32 ), & vdevice % attr % a % fixedwidth /= 0 ) * SCSIZEX call draw_move ( xsave + tcos * tmp , ysave + tsin * tmp , vdevice % cpW ( D_Z )) if ( sync /= 0 ) then vdevice % sync = 1 sync = vdevice % dev % Vsync () end if end subroutine draw_drawchar_integer subroutine draw_drawchar_character ( letter ) character ( len = 1 ), intent ( in ) :: letter call draw_drawchar_integer ( ichar ( letter )) end subroutine draw_drawchar_character subroutine draw_drawhardchar ( c ) character ( len = 1 ), intent ( in ) :: c integer :: idum if ( vdevice % clipoff == 0 ) then if ( vdevice % cpVx - int ( vdevice % hwidth ) > vdevice % maxVx ) return if ( vdevice % cpVx < vdevice % minVx ) return if ( vdevice % cpVy - int ( vdevice % hheight ) > vdevice % maxVy ) return if ( vdevice % cpVy < vdevice % minVy ) return end if idum = vdevice % dev % Vchar ( c ) end subroutine draw_drawhardchar !> !!##NAME !!    textsize(3f) - [M_draw:TEXT] Set text size of a character in the current SOFTWARE font in world units. !!    (LICENSE:PD) !!##SYNOPSIS !! !!         subroutine textsize(width, height) !!         real,intent(in) :: width !!         real,intent(in) :: height !! !!##DESCRIPTION !! !! Set the maximum size of a character in the current font. Width and height !! are values in world units. This applies to software text, but may not apply !! to hardware fonts depending upon the output device. This must !! be done after the font being scaled is loaded. To keep text of different !! sizes aligned along the same baseline not that you typically need to !! subtract the descender height from the Y position !! !!##EXAMPLE !! !!   Sample program: !! !!    program demo_textsize !!    use M_draw !!    implicit none !!    integer :: i,ii !!    integer :: ipaws !!       !! set up long bar as plotting area !!       call prefsize(900,150) !!       call vinit(' ') ! start graphics using device $M_DRAW_DEVICE !!       call ortho2(-30.0, 30.0, -5.0, 5.0) !!       call font('times.r') !! !!       call move2(-23.0,-4.5) !!       call color(D_WHITE) !!       call textsize(2.0,2.0) !!       call move2(-27.5,-3.0) !!       call draw2( 27.5,-3.0) !!       call move2(-27.5,-3.0) !! !!       do i=1,7 !!          ii=nint((i*20)*0.30) !!          call linewidth(nint(ii*2.35)) !!          call textsize(real(i),real(i)) !!          call color(D_MAGENTA) !!          call drawstr('aA') !!       enddo !! !!       ipaws=getkey() !! !!       call vexit() !! !!    end program demo_textsize subroutine draw_textsize ( width , height ) real ( real32 ), intent ( in ) :: width , height real ( real32 ) :: a , p1W ( 4 ), p2W ( 4 ), r1 ( 4 ), r2 ( 4 ) type ( Token ), pointer :: tok (:) if ( vdevice % initialized == 0 ) call draw_verror ( \"textsize: draw not initialized\" ) if ( Loaded == 0 ) call draw_verror ( \"textsize: no font loaded\" ) if ( vdevice % inobject /= 0 ) then tok => draw_newtokens ( 3 ) tok ( 1 )% i = OBJ_TEXTSIZE ; tok ( 2 )% f = width ; tok ( 3 )% f = height return end if vdevice % attr % a % fontwidth = width vdevice % attr % a % fontheight = height if ( vdevice % attr % a % softtext == SOFTHARDWARE ) then p1W = [ width , height , 0.0_real32 , 1.0_real32 ] p2W = [ 0.0_real32 , 0.0_real32 , 0.0_real32 , 1.0_real32 ] call draw_multvector ( r1 , p1W , vdevice % transmat % m ) call draw_multvector ( r2 , p2W , vdevice % transmat % m ) vdevice % hwidth = real ( abs ( draw_WtoVx ( r1 ) - draw_WtoVx ( r2 )), real32 ) vdevice % hheight = real ( abs ( draw_WtoVy ( r1 ) - draw_WtoVy ( r2 )), real32 ) return else if ( vdevice % attr % a % softtext == REALHARDWARE ) then return end if a = real ( max ( ftab % mw , ftab % as - ftab % dec ), real32 ) SCSIZEX = width / a SCSIZEY = height / a end subroutine draw_textsize real ( real32 ) function draw_getfontwidth () real ( real32 ) :: a , b , c , d real ( real32 ), parameter :: fudge = 0.00123_real32 if ( vdevice % initialized == 0 ) call draw_verror ( \"getfontwidth: draw not initialized\" ) if ( vdevice % attr % a % softtext == HERSHEY ) then if ( Loaded == 0 ) call draw_verror ( \"getfontwidth: No font loaded\" ) draw_getfontwidth = SCSIZEX * real ( max ( ftab % mw , ftab % as - ftab % dec ), real32 ) else if ( vdevice % attr % a % softtext == SOFTHARDWARE ) then draw_getfontwidth = vdevice % attr % a % fontwidth else call draw_VtoWxy ( vdevice % hwidth + fudge , vdevice % hheight + fudge , c , d ) call draw_VtoWxy ( fudge , fudge , a , b ) draw_getfontwidth = c - a end if end function draw_getfontwidth real ( real32 ) function draw_getfontheight () real ( real32 ) :: a , b , c , d real ( real32 ), parameter :: fudge = 0.0123_real32 if ( vdevice % initialized == 0 ) call draw_verror ( \"getfontheight: draw not initialized\" ) if ( vdevice % attr % a % softtext == HERSHEY ) then if ( Loaded == 0 ) call draw_verror ( \"getfontheight: No font loaded\" ) draw_getfontheight = SCSIZEY * real ( max ( ftab % mw , ftab % as - ftab % dec ), real32 ) else if ( vdevice % attr % a % softtext == SOFTHARDWARE ) then draw_getfontheight = vdevice % attr % a % fontheight else call draw_VtoWxy ( vdevice % hwidth + fudge , vdevice % hheight + fudge , c , d ) call draw_VtoWxy ( fudge , fudge , a , b ) draw_getfontheight = d - b end if end function draw_getfontheight !> !!##NAME !!    getfontdec(3f) - [M_draw:TEXT] Return size of maximum font descender !!    (LICENSE:PD) !! !!##SYNOPSIS !! !!         real function getfontdec() !!##DESCRIPTION !!    Get the descender size of a character in a font. real ( real32 ) function draw_getfontdec () real ( real32 ) :: a , b , c , d real ( real32 ), parameter :: fudge = 0.0123_real32 if ( vdevice % initialized == 0 ) call draw_verror ( \"getfontdec: draw not initialized\" ) if ( vdevice % attr % a % softtext == HERSHEY ) then if ( Loaded == 0 ) call draw_verror ( \"getfontdec: No font loaded\" ) draw_getfontdec = SCSIZEY * real ( ftab % dec , real32 ) else call draw_VtoWxy ( vdevice % hwidth + fudge , vdevice % 