!!       call prefposition( 0, 0)
!!       call vinit ('X11')
!!       a=1.0
!!    ! make an object to draw ( a disk with an arrow on it)
!!       call makeobj(12345)
!!       call polyfill(.TRUE.)
!!       call color( 5)
!!       call circle( 0.0, 0.0, a)
!!       call color( 3)
